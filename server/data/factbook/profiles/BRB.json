     "items": [
      {
       "label": "history",
       "text": "adopted 22 November 1966, effective 30 November 1966; Constitution (Amendment) (No. 2) Bill, 2021 establishes Barbados as a republic and revokes the earlier Order in Council"
      },
      {
       "label": "amendment process",
       "text": "proposed by Parliament; passage of amendments to constitutional sections such as citizenship, fundamental rights and freedoms, and the organization and authorities of the branches of government requires two-thirds majority vote by the membership of both houses of Parliament; passage of other amendments only requires a majority vote of both houses"
      }
