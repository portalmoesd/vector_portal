   {
    "field": "Judicial branch",
    "order": 140,
    "content": {
     "text": null,
     "items": [
      {
       "label": "highest court(s)",
       "text": "Isle of Man High Court of Justice (consists of 3 permanent judges or \"deemsters\" and 1 judge of appeal; organized into the Staff of Government Division or Court of Appeal and the Civil Division); the Court of General Gaol Delivery (not formally part of the High Court but is administered as such) deals with serious criminal cases"
      },
      {
       "label": "judge selection and term of office",
       "text": "deemsters appointed by the Lord Chancellor of England on the nomination of the lieutenant governor; deemsters can serve until age 70"
      },
      {
       "label": "subordinate courts",
       "text": "High Court; Court of Summary Gaol Delivery; Summary Courts; Magistrate's Court; specialized courts"
      },
      {
       "label": "note",
       "text": "<strong>note:</strong> appeals beyond the Court of Appeal are referred to the Judicial Committee of the Privy Council (in London)"
      }
     ]
    }
   },
